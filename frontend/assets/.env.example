# Environment variables for the Baseball Simulation Expo client
# Copy this file to .env and fill in your values.

# API base URL for the live Python Flask backend (this repo's main.py, port 5000).
# Web (expo start --web): http://localhost:5000 (also the built-in default)
# Android emulator:       http://10.0.2.2:5000
# iOS simulator:          http://127.0.0.1:5000
API_BASE_URL=http://localhost:5000

# Set to "true" to use the in-app mock engine (no server required).
# Set to "false" to connect to the live backend at API_BASE_URL.
# You can also toggle this at runtime via the Dev Menu (Shift+D / tap DEV).
USE_MOCK=true
