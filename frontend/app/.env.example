# Environment variables for the Baseball Simulation Expo client
# Copy this file to .env and fill in your values.

# API base URL for the authoritative Python Flask backend (this repo's main.py,
# port 5050). The client has no offline mode; Flask must be running.
# Web (expo start --web): http://localhost:5050 (also the built-in default)
# Android emulator:       http://10.0.2.2:5050
# iOS simulator:          http://127.0.0.1:5050
API_BASE_URL=http://localhost:5050
